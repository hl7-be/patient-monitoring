# - resource -------------------------------------------------------------------

<http://hl7belgium.org/fhir/patient-monitoring/Organization/Organization-UZL> a fhir:Organization ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "Organization-UZL"] ;
  fhir:Resource.language [ fhir:value "en"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Organization Organization-UZL</b></p><a name=\"Organization-UZL\"> </a><a name=\"hcOrganization-UZL\"> </a><p><b>name</b>: UZ Leuven</p></div>"
  ] ;
  fhir:Organization.name [ fhir:value "UZ Leuven"] .

# - ontology header ------------------------------------------------------------

<http://hl7belgium.org/fhir/patient-monitoring/Organization/Organization-UZL.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

