       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Home Hospitalization Careset Questionnaire Response" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profile on QuestionnaireResponse for OPAT and ONCO home hospitalization caresets. Links the filled-in nursing observation to the originating Encounter and the canonical Questionnaire. See logical model: [CarestQuestionnaireResponse](StructureDefinition-homehosp-questionnaire-response-lm.html)" ] ;
