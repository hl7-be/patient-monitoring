       ] ;
       fhir:name [ fhir:v "Home Hospitalization Careset Questionnaire Response" ] ;
       fhir:description [ fhir:v "Profile on QuestionnaireResponse for OPAT and ONCO home hospitalization caresets. Links the filled-in nursing observation to the originating Encounter and the canonical Questionnaire. See logical model: [CarestQuestionnaireResponse](StructureDefinition-homehosp-questionnaire-response-lm.html)" ] ;
