       fhir:name [ fhir:v "ONCO Fulvestrant Nursing Questionnaire" ] ;
       fhir:description [ fhir:v "Profile on Questionnaire for the ONCO Fulvestrant (Faslodex®) nursing observation form. Captures vital signs, contraindication check, administration (bilateral IM injections) and muscle/joint pain side-effect follow-up. See logical model: [ONCOFulvestrantQuestionnaire](StructureDefinition-onco-fulvestrant-questionnaire.html)" ] ;
