       ] ;
       fhir:name [ fhir:v "ONCO Bortezomib Nursing Questionnaire" ] ;
       fhir:description [ fhir:v "Profile on Questionnaire for the ONCO Bortezomib (Velcade®) nursing observation form. Captures vital signs, medication checks, sensory/motor neuropathy contraindication assessment and post-administration side-effect monitoring. See logical model: [ONCOBortezomibQuestionnaire](StructureDefinition-onco-bortezomib-questionnaire.html)" ] ;
