  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CodeSystem spirometry-grade</b></p><a name=\"spirometry-grade\"> </a><a name=\"hcspirometry-grade\"> </a><p>This case-sensitive code system <code>http://hl7belgium.org/fhir/patient-monitoring/CodeSystem/spirometry-grade</code> defines the following codes:</p><table class=\"codes\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td><td><b>Definition</b></td></tr><tr><td style=\"white-space:nowrap\">A<a name=\"spirometry-grade-A\"> </a></td><td>Grade A</td><td>3 or more acceptable manoeuvres, with the two largest values within 0.150 L of each other.</td></tr><tr><td style=\"white-space:nowrap\">B<a name=\"spirometry-grade-B\"> </a></td><td>Grade B</td><td>2 acceptable manoeuvres, with the two largest values within 0.150 L of each other.</td></tr><tr><td style=\"white-space:nowrap\">C<a name=\"spirometry-grade-C\"> </a></td><td>Grade C</td><td>2 or more acceptable manoeuvres, with the two largest values within 0.200 L of each other.</td></tr><tr><td style=\"white-space:nowrap\">D<a name=\"spirometry-grade-D\"> </a></td><td>Grade D</td><td>2 or more acceptable manoeuvres, with the two largest values within 0.250 L of each other.</td></tr><tr><td style=\"white-space:nowrap\">E<a name=\"spirometry-grade-E\"> </a></td><td>Grade E</td><td>2 or more acceptable manoeuvres with the two largest values more than 0.250 L apart, or only 1 acceptable manoeuvre.</td></tr><tr><td style=\"white-space:nowrap\">U<a name=\"spirometry-grade-U\"> </a></td><td>Grade U</td><td>No acceptable manoeuvres, but at least 1 usable manoeuvre.</td></tr><tr><td style=\"white-space:nowrap\">F<a name=\"spirometry-grade-F\"> </a></td><td>Grade F</td><td>No acceptable and no usable manoeuvres.</td></tr></table></div>"
  ] ;
